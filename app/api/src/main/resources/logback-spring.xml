<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Async Console Appender -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <property name="APP_LOG_PATH" value="${APP_LOG_PATH:-build/test-logs}"/>

    <!-- JSON File Appender (Promtail이 이 경로/포맷을 읽어 Loki로 수집) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${APP_LOG_PATH}/%d{yyyyMMdd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdc>true</includeMdc>
            <includeContext>true</includeContext>
        </encoder>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <root level="INFO">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </root>

    <!-- root 가 INFO 라 PerformanceLogger 의 일반 쿼리 로그(logger.debug)는 그냥 두면 전부 버려진다.
         application.yml 의 logger.rdb/mongo/redis.log-threshold-ms 가 이 DEBUG 오버라이드와 짝을 이룬다. -->
    <logger name="com.langlez.logger" level="DEBUG" additivity="false">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </logger>

    <!-- macOS 네이티브 DNS resolver 미존재 경고: 로컬(macOS)에서만 뜨는 무해한 노이즈, 의존성 추가는 프로덕션(Linux)에 안 맞아서 로그만 숨김 -->
    <logger name="io.netty.resolver.dns.DnsServerAddressStreamProviders" level="ERROR"/>

    <!-- spy.properties 의 appender=Slf4JLogger 가 여기로 쏜다. 커스텀 JdbcEventListener 가
         이미 같은 쿼리를 로깅하므로, 여기서 완전히 죽여 중복 로그를 막는다. -->
    <logger name="p6spy" level="OFF"/>
</configuration>
